  "paths": {
    "/api/data-history/rollback": {
      "post": {
        "tags": ["数据-历史"],
        "summary": "回退数据到历史版本",
        "description": "将指定记录回退到目标历史版本。回退前会自动创建当前状态的快照备份，然后恢复目标版本的数据。",
        "operationId": "rollback",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DataHistoryRollbackDTO"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultDataHistoryVO"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultObject"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultObject"
                }
              }
            }
          },
          "405": {
            "description": "Method Not Allowed",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultObject"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultObject"
                }
              }
            }
          }
        }
      }
    },
    "/api/data-history": {
      "get": {
        "tags": ["数据-历史"],
        "summary": "查询历史版本列表",
        "description": "根据实体类型和记录ID查询该记录的所有历史版本，按版本号降序排列。不包含完整快照JSON，需要详情请使用 GET /{historyId}。",
        "operationId": "listHistory",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/DataHistoryQueryDTO"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
