      "DataHistoryRollbackDTO": {
        "required": ["entityId", "entityType", "targetVersion"],
        "type": "object",
        "properties": {
          "entityType": {
            "type": "string",
            "description": "实体全限定类名",
            "example": "com.astracloud.modules.asset.domain.entity.AssetLibrary"
          },
          "entityId": {
            "type": "string",
            "description": "记录主键ID",
            "example": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
          },
          "targetVersion": {
            "minimum": 1,
            "type": "integer",
            "description": "目标版本号（要回退到的版本）",
            "format": "int32",
            "example": 3
          }
        },
        "description": "数据回退请求"
      },
      "ResultDataHistoryVO": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "description": "响应状态码",
            "format": "int32",
            "example": 200
          },
          "message": {
            "type": "string",
            "description": "响应消息",
            "example": "success"
          },
          "data": {
            "$ref": "#/components/schemas/DataHistoryVO"
          },
          "timestamp": {
            "type": "integer",
            "description": "时间戳(毫秒)",
            "format": "int64"
          }
        }
      },
