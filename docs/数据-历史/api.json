            "example": "com.astracloud.modules.asset.domain.entity.AssetLibrary"
          },
          "entityId": {
            "type": "string",
            "description": "记录主键ID",
            "example": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
          }
        },
        "description": "历史版本查询参数"
      },
      "ResultListDataHistoryVO": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
