    "/api/projects/{projectId}/scripts/{scriptId}/decompose": {
      "post": {
        "tags": ["剧本-拆解"],
        "summary": "拆解剧本为分集",
        "description": "调用 Dify script_decompose 工作流，将剧本原文拆解为多分集 JSON，按序存储到 script_episode 表。支持幂等性：相同内容已处理过则返回缓存结果。force=true 可强制重处理。",
        "operationId": "decompose",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "description": "项目ID",
