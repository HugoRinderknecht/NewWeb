      "ScriptEpisodeUpdateRequest": {
        "type": "object",
        "properties": {
          "scriptId": {
            "type": "string",
            "description": "分集所属的剧本唯一标识符",
            "example": "script-abc123"
          },
          "episodeName": {
            "type": "string",
            "description": "分集名称(用于排序和展示,如第一集、序章、番外等)",
            "example": "第三集"
          },
          "episodeIndex": {
            "type": "integer",
            "description": "分集在剧本中的排序位置(从0开始递增,数字越小越靠前)",
            "format": "int32",
            "example": 2
          },
          "content": {
            "type": "string",
            "description": "分集的剧本正文内容(纯文本)",
            "example": "第三集：陆寻来到大排档，环顾四周寻找方锐的身影..."
          }
        },
        "description": "分集更新/创建请求"
      },
      "ResultVoid": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "description": "响应状态码",
            "format": "int32",
            "example": 200
          },
          "message": {
            "type": "string",
            "description": "响应消息",
            "example": "success"
          },
          "data": {
            "type": "object"
          },
          "timestamp": {
            "type": "integer",
            "description": "时间戳(毫秒)",
            "format": "int64"
          }
        }
      },
      "ScriptDecomposeRequest": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "description": "剧本原文内容（已弃用，服务端从数据库加载）",
            "example": "第一集：陆寻走进大排档..."
          },
          "force": {
            "type": "boolean",
            "description": "是否强制重处理，默认 false。true 时忽略缓存重新调用 Dify"
          }
        },
        "description": "剧本拆解请求"
      },
