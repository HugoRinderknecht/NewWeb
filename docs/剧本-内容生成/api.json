    "/api/projects/{projectId}/scripts/{scriptId}/ref-analysis": {
      "post": {
        "tags": ["剧本-内容生成"],
        "summary": "参考图风格反推",
        "description": "从参考图片中提取风格描述、质感与光影、色彩体系等风格特征，用于风格配置的图片端输入。使用qwen视觉模型分析图片的绘制方式(而非内容)，最多支持5张图片的共性融合或分别描述。也可作为风格配置工作流的嵌入式步骤。结果持久化到ai_ref_analysis表，同时记录Token用量并从积分账户扣减。",
        "operationId": "analyzeReferences",
        "parameters": [
