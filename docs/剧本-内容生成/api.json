    {
      "name": "剧本-内容生成",
      "description": "根据人物小传生成TTS音色提示词，支持生理匹配校验和角色间区分度检查"
    }
  ],
  "paths": {
    "/api/projects/{projectId}/scripts/{scriptId}/voice-prompts": {
      "post": {
        "tags": ["剧本-内容生成"],
        "summary": "生成音色提示词",
        "description": "根据人物小传(需先调用人物小传生成接口)中每个角色的音色参考，生成增强后的TTS音色提示词。包含三个处理步骤：1)生理匹配度校验(年龄/性别vs音色)；2)角色一致性检查(允许'外冷内热'型反差)；3)高频互动角色间区分度检测。主角最多采样10句台词增强分析。最终输出每个角色的基线音色+变化规则+特殊需求的结构化提示词。自动读取ai_character_profiles中的人物小传数据，可通过characterProfileId指定特定小传批次。结果持久化到ai_voice_prompts表，同时记录Token用量并从积分账户扣减。",
        "operationId": "generateVoicePrompts",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "description": "项目唯一标识符",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "proj-abc123"
          },
          {
            "name": "scriptId",
            "in": "path",
            "description": "剧本唯一标识符",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "script-abc123"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VoicePromptRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultAiProcessResultVOVoicePromptResultVO"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultObject"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultObject"
                }
              }
            }
          },
          "405": {
            "description": "Method Not Allowed",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultObject"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultObject"
                }
              }
            }
          }
        }
      }
    },
    "/api/projects/{projectId}/scripts/{scriptId}/style-config": {
      "post": {
        "tags": ["剧本-内容生成"],
        "summary": "生成风格配置",
        "description": "根据文本描述和可选参考图片，生成包含整体画风、光影体系、色彩体系、材质质感、情绪氛围、画质标准、避免特征七维度的完整风格配置。同时生成美术拼接后缀和分镜拼接后缀供后续流程使用。参考图片最多5张，通过Dify工作流中的qwen视觉模型提取风格特征后与文本描述融合。结果持久化到ai_style_config表，同时记录Token用量并从积分账户扣减。",
        "operationId": "generateStyleConfig",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "description": "项目唯一标识符",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "proj-abc123"
          },
          {
            "name": "scriptId",
            "in": "path",
            "description": "剧本唯一标识符",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "script-abc123"
          }
