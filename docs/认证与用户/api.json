            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultObject"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/captcha/email": {
      "post": {
        "tags": ["认证与用户"],
        "summary": "发送邮箱验证码",
        "description": "发送6位数字验证码到指定邮箱,用于密码重置。请求参数: email(必填,邮箱格式)。流程: 邮箱存在性检查(防枚举——邮箱未注册也返回成功,静默不发送)→IP频率限制→邮箱频率限制(同一邮箱60秒内只能发一次,使用Redis SETNX防并发)→生成6位随机数字→存入Redis(默认5分钟TTL)→发送HTML邮件。发送失败时自动清理Redis记录(验证码+频率限制)。限制:5次/分钟(控制器层)+IP级频率限制(服务层)。",
        "operationId": "sendEmailCaptcha",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailCaptchaRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
