            "description": "手机号",
            "example": "13800138000"
          },
          "captchaKey": {
            "type": "string",
            "description": "验证码 key, 调用 GET /api/auth/captcha 时返回的唯一标识",
            "example": "7c1e5a3b9d4f4e2cb8a61f3d5e7a9c2b"
          },
