                }
              }
            }
          }
        }
      }
    },
    "/api/auth/avatar/{userId}": {
      "get": {
        "tags": ["认证与用户"],
        "summary": "获取用户头像(公开)",
        "description": "根据用户ID获取头像信息,公开接口无需登录。与用户信息接口分离,减少不必要的数据传输,可用于前端列表/聊天等场景。返回 AvatarVO: userId、avatar(已解析为可访问URL/data URI)、mediaType(MIME类型如image/jpeg)。媒体类型通过文件名扩展名推断,默认jpeg。",
