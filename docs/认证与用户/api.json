            "type": "string",
            "description": "验证码, 用户在验证码图片中看到的字符(不区分大小写)",
            "example": "A3xF9K"
          },
          "avatar": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string",
            "description": "头像URL(选填,不填则使用默认纯白头像)",
            "example": "data:image/svg+xml,..."
