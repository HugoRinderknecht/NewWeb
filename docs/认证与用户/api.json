    "/api/auth/captcha": {
      "get": {
        "tags": ["认证与用户"],
        "summary": "获取图形验证码",
        "description": "生成4位数字字母组合的图形验证码图片(EasyCaptcha),返回Base64编码的PNG图片(data URI格式)和唯一标识key。验证码文本存入Redis(key=captcha:{uuid},默认TTL=5分钟可配置),验证时一次性消费(校验后立即删除GET+DELETE),大小写不敏感。返回 CaptchaVO: key(UUID无连字符,用于登录/注册时指定验证码)、image(Base64 data URI,可直接用于<img src>)。限制:10次/分钟。",
        "operationId": "getCaptcha",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultCaptchaVO"
                }
              }
            }
