              }
            }
          }
        }
      }
    },
    "/api/auth/avatar": {
      "post": {
        "tags": ["认证与用户"],
        "summary": "上传头像",
        "description": "上传本地图片文件作为当前登录用户的头像。上传流程: 校验MIME类型→校验文件大小→校验文件扩展名(须与MIME类型匹配)→上传至存储服务→更新数据库。格式限制: 仅支持 JPEG(.jpg/.jpeg)/PNG(.png)/GIF(.gif)/WebP(.webp),文件不超过5MB。存储路径: avatars/{userId}/{UUID}.{ext},旧头像不会被自动删除。请求格式: multipart/form-data,参数名 file。返回更新后的完整 UserVO。",
        "operationId": "uploadAvatar",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "required": ["file"],
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "description": "头像图片文件,支持JPEG/PNG/GIF/WebP,≤5MB",
                    "format": "binary"
                  }
                }
              }
            }
