    "/api/auth/permissions": {
      "get": {
        "tags": ["认证与用户"],
        "summary": "获取当前用户权限信息",
        "description": "返回用户在当前团队上下文中的完整权限信息: 角色组(roleGroup/roleGroupName/roleLevel)、可见模块列表(modules)、可执行操作列表(actions)、审核权限范围(reviewScopes)、团队信息(teamInfo)、参与的项目ID列表(projectIds)。teamId 可选，未传时使用当前团队上下文。结果缓存5分钟，角色变更时自动失效。",
        "operationId": "getPermissions",
        "parameters": [
          {
            "name": "teamId",
            "in": "query",
            "description": "团队ID(可选,默认使用当前团队)",
