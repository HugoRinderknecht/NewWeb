            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultObject"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/refresh": {
      "post": {
        "tags": ["认证与用户"],
        "summary": "刷新 AccessToken(需登录)",
        "description": "基于旧AccessToken获取新的AccessToken。需要用户处于登录状态(需有效JWT)。流程: 校验当前登录态→查询用户→吊销旧Token(加入黑名单,移除旧会话)→生成新AccessToken→注册新会话。重要: 此接口仅刷新AccessToken,返回的LoginVO中refreshToken字段为null,不返回新RefreshToken。如需获取新的AccessToken+RefreshToken对,请使用 POST /api/auth/refresh-token。限制:10次/分钟。",
        "operationId": "refreshToken",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultLoginVO"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultObject"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultObject"
                }
              }
            }
          },
          "405": {
            "description": "Method Not Allowed",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultObject"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultObject"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/refresh-token": {
      "post": {
        "tags": ["认证与用户"],
        "summary": "基于RefreshToken刷新(无需登录)",
        "description": "使用RefreshToken获取新的AccessToken+RefreshToken对。不需要用户处于登录状态(AccessToken过期时也可用)。请求参数: refreshToken(必填,RefreshToken字符串)。流程: 验证RefreshToken签名和类型→检查是否在黑名单→提取用户名→查询用户并校验状态(禁用用户拒绝)→吊销旧RefreshToken→生成新Token对→注册新会话。返回 LoginVO: 新的AccessToken+RefreshToken对,含双Token过期时间。与 POST /api/auth/refresh 的关键区别: ①不需要登录态,②返回新的RefreshToken,③仅限5次/分钟。",
        "operationId": "refreshAccessToken",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultLoginVO"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "*/*": {
