    "/api/auth/me": {
      "get": {
        "tags": ["认证与用户"],
        "summary": "获取当前用户",
        "description": "从SecurityContext中获取当前登录用户的完整个人信息。需要有效的JWT Token(Authorization: Bearer {token})。返回 UserVO: id(UUID)、username、email、phone、avatar(已解析为可访问URL/data URI)、status(0-禁用/1-正常)、createTime、updateTime、roles(系统角色编码列表,如[\"team_member\"])。",
        "operationId": "getCurrentUser",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultUserVO"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultObject"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
