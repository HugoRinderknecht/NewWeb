        "required": ["videoPromptId"],
        "type": "object",
        "properties": {
          "videoPromptId": {
            "type": "string",
            "description": "视频提示词记录ID（ai_video_prompts.id）"
          },
          "force": {
            "type": "boolean",
            "description": "是否强制重处理，默认 false"
          }
        },
