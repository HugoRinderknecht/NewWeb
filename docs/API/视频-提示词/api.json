            "example": 200
          },
          "message": {
            "type": "string",
            "description": "响应消息",
            "example": "success"
          },
          "data": {
            "$ref": "#/components/schemas/AiProcessResultVOViolationCheckResultVO"
          },
          "timestamp": {
            "type": "integer",
            "description": "时间戳(毫秒)",
            "format": "int64"
          }
        }
      },
      "PromptFixRequest": {
        "required": ["modifyInstructions", "videoPromptId"],
        "type": "object",
        "properties": {
          "videoPromptId": {
            "type": "string",
            "description": "视频提示词记录ID（ai_video_prompts.id）"
          },
          "modifyInstructions": {
            "type": "string",
            "description": "修改说明（替换违规词、调整描述等）",
            "example": "将'虐杀'替换为'激烈战斗'"
          },
          "force": {
            "type": "boolean",
            "description": "是否强制重处理，默认 false"
          }
        },
        "description": "视频提示词修改请求"
      },
      "ResultAiProcessResultVOPromptFixResultVO": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
