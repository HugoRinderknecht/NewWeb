{
  "openapi": "3.0.1",
  "info": {
    "title": "OpenAPI definition - 视频-提示词",
    "version": "v0",
    "description": "模块: 视频-提示词"
  },
  "servers": [
    {
      "url": "http://server.bsuniversal.cn:10006",
      "description": "Generated server url"
    }
