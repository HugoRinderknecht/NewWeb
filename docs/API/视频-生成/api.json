            }
          }
        }
      }
    },
    "/api/seedance/generations": {
      "post": {
        "tags": ["视频-生成"],
        "summary": "提交视频生成任务",
        "description": "提交 Seedance 2.0 视频生成任务，进入排队队列（最大并发10）。\n\n快捷模式：传入 prompt/images/videos/audioUrls，后端自动构建 v3 content 数组。\n首张图片自动设为首帧(role=first_frame)，其余为参考图(role=reference_image)。\n\n模型: doubao-seedance-2-0-260128 (480p/720p/1080p) | doubao-seedance-2-0-fast-260128 (480p/720p)\n时长: 4-15秒  分辨率: 480p/720p/1080p\n宽高比: 21:9/16:9/4:3/1:1/3:4/9:16/adaptive\n\n重要: 提交前必须先调用 POST /generations/preview 获取 previewToken，并在本请求中回传。\n",
        "operationId": "generate",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SeedanceGenerateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultSeedanceSubmitVO"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultObject"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultObject"
                }
              }
            }
          },
          "405": {
            "description": "Method Not Allowed",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultObject"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultObject"
                }
              }
            }
          }
        }
      }
    },
    "/api/seedance/generations/preview": {
      "post": {
        "tags": ["视频-生成"],
        "summary": "预览视频生成参数（提交前确认）",
        "description": "预览视频生成参数，返回将生成的视频数量、总时长、分辨率、模型、预估积分、分镜明细(批量时)。\n\n返回的 previewToken 需在提交生成时回传，确保参数与预览一致。\n提交前必须调用此接口确认参数，否则 generate 接口会拒绝请求。\n",
        "operationId": "preview",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SeedanceGenerateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultSeedancePreviewVO"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
