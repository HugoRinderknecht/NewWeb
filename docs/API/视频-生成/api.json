    "/api/seedance/tasks/{taskId}/result": {
      "get": {
        "tags": ["视频-生成"],
        "summary": "获取任务结果（含积分消耗）",
        "description": "获取已完成任务的视频URL和积分消耗。仅当 status=succeeded 时返回。",
        "operationId": "getTaskResult",
        "parameters": [
          {
            "name": "taskId",
            "in": "path",
