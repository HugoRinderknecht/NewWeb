  "components": {
    "schemas": {
      "ResultVoid": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "description": "响应状态码",
            "format": "int32",
            "example": 200
          },
          "message": {
            "type": "string",
            "description": "响应消息",
            "example": "success"
          },
          "data": {
            "type": "object"
          },
          "timestamp": {
            "type": "integer",
            "description": "时间戳(毫秒)",
            "format": "int64"
          }
        }
      },
      "ResultObject": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "description": "响应状态码",
            "format": "int32",
            "example": 200
          },
          "message": {
            "type": "string",
            "description": "响应消息",
            "example": "success"
          },
          "data": {
            "type": "object"
          },
          "timestamp": {
            "type": "integer",
            "description": "时间戳(毫秒)",
            "format": "int64"
          }
        }
      },
      "SeedanceGenerateRequest": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "description": "模型ID: doubao-seedance-2-0-260128 | doubao-seedance-2-0-fast-260128",
            "example": "doubao-seedance-2-0-260128",
            "default": "doubao-seedance-2-0-260128"
          },
          "prompt": {
            "maxLength": 1000,
            "minLength": 0,
            "type": "string",
            "description": "视频描述文本(中英文，≤1000字符)",
            "example": "一只金毛犬在阳光明媚的草地上奔跑，电影级光影，慢动作"
          },
          "images": {
            "maxItems": 9,
            "minItems": 0,
            "type": "array",
            "description": "参考图片URL数组(最多9张)，首帧=列表第一个，尾帧=列表第二个(可选)",
            "items": {
              "type": "string",
              "description": "参考图片URL数组(最多9张)，首帧=列表第一个，尾帧=列表第二个(可选)"
            }
          },
          "videos": {
            "maxItems": 3,
            "minItems": 0,
            "type": "array",
            "description": "参考视频URL数组(最多3个，合计≤15秒)",
            "items": {
              "type": "string",
              "description": "参考视频URL数组(最多3个，合计≤15秒)"
            }
          },
          "audioUrls": {
            "maxItems": 3,
            "minItems": 0,
            "type": "array",
            "description": "参考音频URL数组(最多3个，合计≤15秒)",
            "items": {
              "type": "string",
              "description": "参考音频URL数组(最多3个，合计≤15秒)"
            }
          },
          "resolution": {
            "type": "string",
            "description": "分辨率: 480p | 720p | 1080p (fast模型不支持1080p)",
            "example": "720p",
            "default": "720p"
          },
          "ratio": {
            "type": "string",
            "description": "宽高比: 16:9 | 4:3 | 1:1 | 3:4 | 9:16 | 21:9 | adaptive",
            "example": "16:9",
            "default": "adaptive"
          },
          "duration": {
            "type": "integer",
            "description": "视频时长(秒): 4-15, 或 -1 由模型自动选择",
            "format": "int32",
            "example": 5,
            "default": 5
          },
          "frames": {
            "type": "integer",
            "description": "帧数 (与duration二选一, frames优先级更高)",
            "format": "int32",
            "example": 120
          },
          "seed": {
            "type": "integer",
            "description": "种子整数(-1=随机), 用于复现结果",
            "format": "int32",
            "example": -1,
            "default": -1
          },
          "cameraFixed": {
            "type": "boolean",
            "description": "是否固定摄像头",
            "default": false
          },
          "watermark": {
            "type": "boolean",
            "description": "是否添加水印",
            "default": false
          },
          "generateAudio": {
            "type": "boolean",
            "description": "是否生成同步音频(人声/音效/BGM)",
            "default": true
          },
          "priority": {
            "type": "integer",
            "description": "队列优先级 0-9, 越大越优先",
            "format": "int32",
            "example": 0,
            "default": 0
          },
          "returnLastFrame": {
            "type": "boolean",
            "description": "是否返回尾帧图像(用于连续视频生成)",
            "default": false
          },
          "serviceTier": {
            "type": "string",
            "description": "服务等级: default(在线) | flex(离线,半价)",
            "default": "default"
          },
          "executionExpiresAfter": {
            "type": "integer",
            "description": "任务超时阈值(秒), 默认172800(48h)",
            "format": "int32",
            "example": 86400
          },
          "callbackUrl": {
            "type": "string",
            "description": "回调通知URL(任务状态变更时推送)"
          },
          "safetyIdentifier": {
            "type": "string",
            "description": "终端用户标识符(用于安全审核), 长度≤64"
          },
          "projectId": {
            "type": "string",
            "description": "关联项目ID(必填)",
            "example": "proj-001"
          },
          "scriptId": {
            "type": "string",
            "description": "关联剧本ID(从分镜生成视频时必填)",
            "example": "script-001"
          },
          "storyboardId": {
            "type": "string",
            "description": "分镜ID(从分镜生成视频时必填, 自动读取durationSeconds/prompt/资产图等)"
          },
          "episodeId": {
            "type": "string",
            "description": "大集ID(从大集批量生成视频时使用, 自动遍历大集下所有分镜分别提交, 与storyboardId互斥)"
          },
          "previewToken": {
            "type": "string",
            "description": "预览确认令牌(调用预览接口获取, 提交时必传以确保生成参数与预览一致)"
          }
        },
        "description": "Seedance 视频生成请求 (兼容 v3 API content 数组格式)"
      },
      "ResultSeedanceSubmitVO": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "description": "响应状态码",
            "format": "int32",
            "example": 200
          },
          "message": {
            "type": "string",
