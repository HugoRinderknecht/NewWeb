                  "$ref": "#/components/schemas/ResultObject"
                }
              }
            }
          }
        }
      }
    },
    "/api/seedance/tasks": {
      "get": {
        "tags": ["视频-生成"],
        "summary": "查询任务列表",
        "description": "查询当前用户的视频生成任务列表，可按项目ID筛选，按创建时间倒序排列",
        "operationId": "listTasks",
        "parameters": [
          {
            "name": "projectId",
            "in": "query",
