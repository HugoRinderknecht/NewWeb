    "/api/projects/{projectId}/scripts/{scriptId}/assets/prompts": {
      "post": {
        "tags": ["剧本-资产"],
        "summary": "生成资产提示词",
        "description": "根据已提取的资产表(需先调用提取资产表接口)，为每个人物/场景/道具生成对应的图片生成提示词。人物：4视角角色立绘(正面/侧面/背面/头像特写)，白色背景，柔光；场景：广角平视，无透视畸变，无人物/动物，无动态模糊；道具：5视角(正面/侧面/背面/顶部/细节微距)，白色背景。自动读取creative_asset中的资产数据，可通过assetExtractId指定特定提取批次。结果持久化到creative_asset表，同时记录Token用量并从积分账户扣减。",
        "operationId": "generateAssetPrompts",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "description": "项目唯一标识符",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "proj-abc123"
          },
          {
            "name": "scriptId",
            "in": "path",
            "description": "剧本唯一标识符",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "script-abc123"
