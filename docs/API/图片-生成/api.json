            "description": "Internal Server Error",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultObject"
                }
              }
            }
          }
        }
      }
    },
    "/api/gpt-image/tasks/{taskId}": {
      "get": {
        "tags": ["图片-生成"],
        "summary": "查询任务状态",
        "description": "查询 GPT-Image-2 任务的处理状态和进度。状态值: submitted(已提交)/processing(处理中)/completed(已完成)/failed(失败)。completed时返回图片URL列表及实际费用(cost)。",
        "operationId": "getTaskStatus_1",
        "parameters": [
          {
            "name": "taskId",
            "in": "path",
            "description": "任务ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
