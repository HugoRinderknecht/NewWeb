  "components": {
    "schemas": {
      "GptImageGenerateRequest": {
        "required": ["prompt"],
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "description": "图片描述文本(中英文均可)",
            "example": "A ginger cat sitting on a windowsill, watercolor style"
          },
          "size": {
            "type": "string",
            "description": "图像生成比例, 支持15种比例和auto/像素尺寸",
            "example": "16:9",
            "enum": [
              "auto",
              "1:1",
              "3:2",
              "2:3",
              "4:3",
              "3:4",
              "5:4",
              "4:5",
              "16:9",
              "9:16",
              "2:1",
              "1:2",
              "3:1",
              "1:3",
              "21:9",
              "9:21"
            ],
            "default": "1:1"
          },
          "resolution": {
            "type": "string",
            "description": "输出分辨率档位: 1k/2k/4k",
            "example": "2k",
            "enum": ["1k", "2k", "4k"],
            "default": "1k"
          },
          "n": {
            "type": "integer",
            "description": "生成图片数量(当前仅支持1)",
            "format": "int32",
            "example": 1,
            "default": 1
          },
          "referenceImages": {
            "type": "array",
            "description": "参考图URL数组(图生图模式, 最多16张, 支持URL与base64混填)",
            "items": {
              "type": "string",
              "description": "参考图URL数组(图生图模式, 最多16张, 支持URL与base64混填)"
            }
          },
          "officialFallback": {
            "type": "boolean",
            "description": "是否使用官方渠道兜底",
            "default": false
          },
          "quality": {
            "type": "string",
            "description": "质量: low/medium/high/auto",
            "example": "high",
            "default": "auto"
          },
          "callbackUrl": {
            "type": "string",
            "description": "完成回调URL"
          },
          "projectId": {
            "type": "string",
            "description": "关联项目ID(用于积分扣减)"
          },
          "model": {
            "type": "string",
            "description": "模型编码: gpt-image-2 / gpt-image-2-official",
            "default": "gpt-image-2"
          },
          "outputFormat": {
            "type": "string",
            "description": "输出格式: png/jpeg/webp",
            "default": "png"
          },
          "outputCompression": {
            "type": "integer",
            "description": "输出压缩强度 0-100",
            "format": "int32"
          },
          "background": {
            "type": "string",
            "description": "背景模式: auto/opaque/transparent"
          },
          "moderation": {
            "type": "string",
            "description": "审核强度: auto/low"
          },
          "maskUrl": {
            "type": "string",
            "description": "遮罩图URL (局部重绘)"
          }
        },
        "description": "GPT-Image-2 图片生成请求"
      },
      "ResultGptImageSubmitVO": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "description": "响应状态码",
            "format": "int32",
            "example": 200
          },
          "message": {
            "type": "string",
            "description": "响应消息",
            "example": "success"
          },
          "data": {
            "$ref": "#/components/schemas/GptImageSubmitVO"
          },
          "timestamp": {
