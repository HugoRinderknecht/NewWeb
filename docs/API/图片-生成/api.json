  "paths": {
    "/api/gpt-image/generations": {
      "post": {
        "tags": ["图片-生成"],
        "summary": "提交图片生成任务",
        "description": "提交 GPT-Image-2 图片生成请求,返回任务ID用于后续查询。支持文生图和图生图(referenceImages参数)。尺寸: 1:1/16:9 等; 分辨率: 1k/2k/4k; 质量: low/medium/high/auto。",
        "operationId": "generate_1",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GptImageGenerateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultGptImageSubmitVO"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultObject"
                }
              }
