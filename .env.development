# 【开发】环境变量

# 应用部署基础路径（如部署在子目录 /admin，则设置为 /admin/）
VITE_BASE_URL = /

# API 请求基础路径（开发环境设置为 / 使用代理，生产环境设置为完整后端地址）
VITE_API_URL = /

# 代理目标地址（开发环境通过 Vite 代理转发请求到此地址，解决跨域问题）
VITE_API_PROXY_URL = http://server.bsuniversal.cn:10006

# Delete console
VITE_DROP_CONSOLE = false

# API模式: mock=纯模拟 / http=纯后端 / hybrid=混合模式
VITE_API_MODE = http

# 混合模式下使用mock的URL模式（逗号分隔的正则表达式）
VITE_MOCK_PATTERNS =
