# ===== 测试运行环境配置 =====
# 复制本文件为 .env 并按需修改；CI 环境可通过环境变量覆盖

# --- 基础 URL（前端应用入口）---
BASE_URL=http://localhost:3006
LOGIN_URL=http://localhost:3006/auth/login

# --- 浏览器 ---
HEADLESS=false
BROWSER=chromium                  # chromium | firefox | webkit
SLOW_MO=0                         # 调试时设置 100-500 放慢操作
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080
LOCALE=zh-CN
TIMEZONE=Asia/Shanghai

# --- 测试账号（按角色提供）---
# ⚠️ 平台管理员账号（用户提供）
ADMIN_USERNAME=17369359010
ADMIN_PASSWORD=Kill242002
# 团队管理员（首次执行会自动创建普通账号，请按需修改）
TEAM_ADMIN_USERNAME=team_admin
TEAM_ADMIN_PASSWORD=Test1234
# 普通成员（首次执行会自动创建普通账号，请按需修改）
MEMBER_USERNAME=member
MEMBER_PASSWORD=Test1234

# --- 后端 API 基础地址（用于响应拦截与断言）---
API_BASE_URL=http://server.bsuniversal.cn:10006

# --- 报告配置 ---
HTML_REPORT_PATH=reports/html
ALLURE_RESULTS_DIR=reports/allure-results
SCREENSHOT_DIR=reports/screenshots
LOG_DIR=reports/logs
VIDEO_DIR=reports/videos
TRACE_DIR=reports/traces

# --- 失败处理 ---
RETRY_FAILED=2                    # 失败重试次数
SCREENSHOT_ON_FAIL=true
VIDEO_ON_FAIL=true
TRACE_ON_FAIL=true

# --- 网络等待 ---
DEFAULT_TIMEOUT=15000             # 默认元素等待 15s
NAV_TIMEOUT=30000                 # 页面导航超时 30s
ACTION_TIMEOUT=10000              # 操作超时 10s
